# ==============================================================================
# CampusResQ / Safety Exit — Environment Variable Template
# ==============================================================================
# Copy this file to .env and configure with your specific venue & API credentials.
# Note: For production deployments on Render, private credentials (MAPPEDIN_KEY,
# MAPPEDIN_SECRET) are kept on the server-side auth service (safety-exit-api).
# The frontend client connects to MAPPEDIN_AUTH_URL to receive short-lived access tokens.
# ==============================================================================

# Mappedin Venue / Map ID (Default demo: 6878b313316caa000b260be4)
MAPPEDIN_MAP_ID=your_mappedin_map_id_here

# Mappedin Client Key (Server-side only in production; e.g., mik_...)
MAPPEDIN_KEY=your_mappedin_client_key_here

# Mappedin Client Secret (Server-side only in production; e.g., mis_...)
MAPPEDIN_SECRET=your_mappedin_client_secret_here

# Mappedin Region Environment ("us" | "eu" | "ind")
MAPPEDIN_ENV=us

# (Frontend) Optional backend token service URL (e.g., https://safety-exit-api.onrender.com/api/mappedin-token)
MAPPEDIN_AUTH_URL=https://safety-exit-api.onrender.com/api/mappedin-token

# (Server) Allowed frontend origin for CORS
CORS_ORIGIN=https://safety-exit.onrender.com
